PORT=3000
HOST=0.0.0.0
OTA_API_KEY=change-me

# GitHub raw: when set, GET reads manifest from this URL (S3 ignored for GET).
# Placeholders: {appId} {platform} {channel}
# Example: https://raw.githubusercontent.com/YOU/REPO/main/ota/{appId}/{platform}/{channel}/current.json
# OTA_GITHUB_MANIFEST_URL_TEMPLATE=

# S3 (used only if OTA_GITHUB_MANIFEST_URL_TEMPLATE is unset)
S3_REGION=auto
S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 example (omit for AWS):
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Presigned GET TTL for bundleUrl (seconds)
PRESIGN_TTL_SECONDS=900
